# Spark Lab Storefront Environment Configuration
# Copy this file to .env for local development or configure in your hosting platform.

# Live Catalog Configuration (Google Sheets)
# Google Sheets ID (from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
VITE_GOOGLE_SHEET_ID=

# Worksheet / Tab name in Google Sheets
VITE_GOOGLE_SHEET_TAB=Website Products

# Optional direct CSV catalog URL override (backward compatibility)
# VITE_GOOGLE_SHEETS_CATALOG_URL=

# =================================================================
# SERVER-SIDE / CLOUD FUNCTION VARIABLES (NEVER EXPOSE IN CLIENT)
# =================================================================
# IMPORTANT: Never prefix secret API keys with VITE_.
# Place secret API keys ONLY in server-side function environments (e.g. Netlify Functions / Vercel Serverless).
# GEMINI_API_KEY=
# Recommended for deeper IoT and research-project analysis.
GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 thinking-token budget (512–24576). Higher values increase depth and response time/cost.
GEMINI_THINKING_BUDGET=8192
# OPENAI_API_KEY=
